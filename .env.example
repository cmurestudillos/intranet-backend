# ── MongoDB ────────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/intranet
# Vercel: mongodb+srv://user:pass@cluster.mongodb.net/intranet  (Atlas obligatorio)
MONGODB_URI=mongodb://localhost:27017/intranet

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:8080

# ── Uploads ────────────────────────────────────────────────────────────────────
# Local:  uploads
# Vercel: /tmp/uploads  (efímero — en producción real usar Cloudinary o S3)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

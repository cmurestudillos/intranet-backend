{
  "info": {
    "name": "Intranet API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Mur\",\n  \"email\": \"carlos@ejemplo.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('token', res.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@ejemplo.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Me (usuario actual)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Tareas",
      "item": [
        {
          "name": "Listar pendientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks?estado=false",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Listar completadas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks?estado=true",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Obtener por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{tareaId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Crear tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.task?.id) pm.collectionVariables.set('tareaId', res.task.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tarea de prueba\",\n  \"horas\": 2,\n  \"prioridad\": \"media\"\n}"
            }
          }
        },
        {
          "name": "Editar tarea",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/tasks/{{tareaId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tarea editada\",\n  \"horas\": 3,\n  \"prioridad\": \"alta\"\n}"
            }
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{tareaId}}/estado",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Eliminar tarea",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{tareaId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Listar mensajes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/chat",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Enviar mensaje (REST)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/chat",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mensaje\": \"Hola desde Postman!\",\n  \"nombre\": \"Carlos\",\n  \"foto\": \"\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Documentos",
      "item": [
        {
          "name": "Listar documentos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/documents",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Subir documento",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/documents/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Eliminar documento",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/documents/{{documentoId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Actualizar avatar",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/users/avatar",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "avatar", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    }
  ]
}
